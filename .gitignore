.ruff_cache/
.coverage
.coverage.*
htmlcov/
site/

# Jupyter / notebooks
.ipynb_checkpoints/
**/.ipynb_checkpoints/

# -----------------------------------------------------------------------------
# Java / Kotlin / JVM ecosystem
# -----------------------------------------------------------------------------
*.class
*.jar
*.war
*.ear
*.nar
*.zip
*.tar
*.tar.gz
*.tgz
target/
out/
.gradle/
build/

# -----------------------------------------------------------------------------
# Node / JS / TS / frontend frameworks
# -----------------------------------------------------------------------------
node_modules/
.npm/
.pnpm-store/
.yarn/
.yarn-cache/
.yarn/install-state.gz
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
coverage/
.cache/
.next/
.nuxt/
.svelte-kit/
.angular/
.vite/
dist/
build/
*.tsbuildinfo
vite.config.*.timestamp*

# -----------------------------------------------------------------------------
# Flutter / Dart
# -----------------------------------------------------------------------------
.dart_tool/
.packages
.pub/
.pub-cache/
build/
.flutter-plugins
.flutter-plugins-dependencies
pubspec.lock
android/.gradle/
android/key.properties
**/android/app/*.keystore
ios/Flutter/Generated.xcconfig
ios/Flutter/ephemeral/
ios/Pods/
ios/Podfile.lock
**/.symlinks/
# End Flutter/Dart

# Misc. language / framework build outputs
# -----------------------------------------------------------------------------
# Maven / Gradle wrappers usually stay tracked, but generated outputs do not.
**/target/
**/build/
**/out/
**/bin/
**/obj/

# -----------------------------------------------------------------------------
# Environment files / secrets / local config
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12
*.pfx
secrets/
credentials/
*.local.json
appsettings.Development.json
appsettings.Local.json
connectionStrings*.json
local.properties

# -----------------------------------------------------------------------------
# Git / repository hygiene
# -----------------------------------------------------------------------------
.git/

# Keep the repo clean from generated logs
*.log
logs/
*.pid
*.seed
*.pid.lock
