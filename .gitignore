*.azurePubxml
*.publishproj
*.snk
*.appx
*.appxbundle
*.appxupload
*.nupkg
*.snupkg
*.nuspec
packages/
!packages/build/
MigrationBackup/

# SQL / local database files
*.mdf
*.ldf
*.ndf
*.bak
*.db
*.sqlite
*.sqlite3
*.db-shm
*.db-wal
*.sqlproj.user

