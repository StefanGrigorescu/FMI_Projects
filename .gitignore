# -----------------------------------------------------------------------------
# Repository-wide .gitignore for a mixed college project portfolio
# Covers IDEs, languages, frameworks, generated outputs, local tooling, and secrets.
# -----------------------------------------------------------------------------

# OS / filesystem noise
.DS_Store
Thumbs.db
Desktop.ini
._*
*.swp
*.swo
*.tmp
*.temp
*.bak
*.orig
*.rej
*~

# -----------------------------------------------------------------------------
# Editors / IDEs
# -----------------------------------------------------------------------------

# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace
.history/
.localhistory/

# JetBrains IDEs (PyCharm, IntelliJ, Rider, etc.)
.idea/
*.iml
*.iws
*.ipr

# Visual Studio / .NET
.vs/
*.vs/
*.suo
*.user
*.userosscache
*.sln.docstates
*.rsuser
