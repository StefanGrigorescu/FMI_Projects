*.aps
*.ncb
*.opt
*.plg
*.vbw
*.vbp
*.dsw
*.dsp
*.cache
*.VC.db
*.VC.VC.opendb
*.psess
*.vsp
*.vspx
*.sap
*.pdb
*.ilk
*.iobj
*.ipdb
*.pgc
*.pgd
*.sbr
*.tlb
*.tli
*.tlh
*.tmp_proj
*_wpftmp.csproj
*.log
*.tlog
*.vspscc
*.vssscc
*.dbmdl
*.jfm
*.pfx
*.publishsettings
*.rptproj.bak
*.VisualState.xml
TestResult.xml
TestResults/

