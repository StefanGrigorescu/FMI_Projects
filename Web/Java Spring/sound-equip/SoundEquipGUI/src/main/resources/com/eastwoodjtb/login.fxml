<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.scene.text.Font?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.eastwoodjtb.controllers.LoginController"
            prefHeight="400.0" prefWidth="600.0">
    <HBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0"
          prefWidth="600.0" xmlns="http://javafx.com/javafx/16" xmlns:fx="http://javafx.com/fxml/1">
        <AnchorPane prefHeight="400.0" prefWidth="254.0" style="-fx-background-color: #CCCCFF;">
            <ImageView fitHeight="227.0" fitWidth="227.0" layoutX="12.0" layoutY="86.0" pickOnBounds="true"
                       preserveRatio="true">
                <Image url="@KepoDepo.png"/>
            </ImageView>
            <Label id="lbl-eastwood" layoutX="137.0" layoutY="236.0" text="EaStwood JTB" textFill="#8561c7">
                <font>
                    <Font name="Comic Sans MS Bold" size="14.0"/>
                </font>
            </Label>
            <Label id="lbl-email" layoutX="34.0" layoutY="323.0" text="grigorescu2001@gmail.com">
                <font>
                    <Font name="Constantia Bold Italic" size="16.0"/>
                </font>
            </Label>
        </AnchorPane>
        <AnchorPane prefHeight="400.0" prefWidth="352.0"
                    style="-fx-background-color: #FDFEFE; -fx-border-width: 2px; -fx-border-color: #D7BDE2;">
            <PasswordField id="pf_password_login" layoutX="135.0" layoutY="269.0" prefHeight="25.0" prefWidth="181.0"/>
            <Label id="lbl-password" layoutX="20.0" layoutY="272.0" text="Password:">
                <font>
                    <Font name="Constantia Bold Italic" size="16.0"/>
                </font>
            </Label>
            <ImageView fitHeight="150.0" fitWidth="200.0" layoutX="99.0" layoutY="30.0" pickOnBounds="true"
                       preserveRatio="true">
                <Image url="@lock.png"/>
            </ImageView>
            <Label id="lbl-username" layoutX="19.0" layoutY="207.0" prefHeight="19.0" prefWidth="81.0" text="Username:">
                <font>
                    <Font name="Constantia Bold Italic" size="16.0"/>
                </font>
            </Label>
            <TextField id="tf_username_login" layoutX="135.0" layoutY="200.0" prefHeight="25.0" prefWidth="181.0">
                <font>
                    <Font name="Comic Sans MS" size="16.0"/>
                </font>
            </TextField>
            <Button id="btn_login_login" layoutX="52.0" layoutY="337.0" mnemonicParsing="false" prefHeight="28.0"
                    prefWidth="77.0"
                    style="-fx-background-color: #CCCCFF; -fx-border-width: 1px; -fx-border-color: #2C3E50;"
                    text="Login">
                <font>
                    <Font name="Constantia Bold" size="14.0"/>
                </font>
            </Button>
            <Label id="lbl-register" layoutX="164.0" layoutY="330.0" text="Not registered yet?">
                <font>
                    <Font name="Constantia Bold" size="14.0"/>
                </font>
            </Label>
            <Hyperlink id="lnk_register_login" layoutX="175.0" layoutY="352.0" text="Register now!" underline="true">
                <font>
                    <Font name="Constantia Bold" size="12.0"/>
                </font>
            </Hyperlink>
        </AnchorPane>
    </HBox>
</AnchorPane>
